{
  "name": "@nudge/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    "./config": {
      "types": "./dist/config.d.ts",
      "development": "./src/config.ts",
      "default": "./dist/config.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "development": "./src/paths.ts",
      "default": "./dist/paths.js"
    },
    "./google": {
      "types": "./dist/google.d.ts",
      "development": "./src/google.ts",
      "default": "./dist/google.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --conditions=development src/index.ts",
    "start": "pnpm --filter @nudge/server... build && node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nudge/agent": "workspace:*",
    "@nudge/photon": "workspace:*",
    "@nudge/schedule": "workspace:*",
    "@nudge/store": "workspace:*",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
