{
  "name": "@nudge/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --conditions=development src/index.ts",
    "start": "node dist/index.js",
    "auth:chatgpt": "tsx --conditions=development src/auth-cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nudge/agent": "workspace:*",
    "@nudge/photon": "workspace:*",
    "@nudge/schedule": "workspace:*",
    "@nudge/store": "workspace:*",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
