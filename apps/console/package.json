{
  "name": "@nudge/console",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch --conditions=development src/server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "start": "node dist/server/index.js",
    "auth": "tsx --conditions=development src/server/auth-cli.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@elysiajs/node": "^1.4.5",
    "@nudge/agent": "workspace:*",
    "@nudge/schedule": "workspace:*",
    "@nudge/server": "workspace:*",
    "@nudge/store": "workspace:*",
    "elysia": "^1.4.29"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/lang-yaml": "^6.1.0",
    "@codemirror/view": "^6.38.0",
    "@fontsource-variable/geist": "^5.2.0",
    "@fontsource-variable/geist-mono": "^5.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-query": "^5.90.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@uiw/react-codemirror": "^4.25.0",
    "@vitejs/plugin-react": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.0",
    "lucide-react": "^0.545.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.9.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^4.0.18"
  }
}
