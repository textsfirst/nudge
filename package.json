{
  "name": "nudge",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -k -n nudge,console-api,console-web -c blue,magenta,cyan \"pnpm --filter @nudge/server dev\" \"pnpm --filter @nudge/console dev:api\" \"pnpm --filter @nudge/console dev:web\"",
    "dev:nudge": "pnpm --filter @nudge/server dev",
    "dev:agent": "pnpm dev:nudge",
    "dev:console": "pnpm --filter @nudge/console dev",
    "console": "pnpm dev:console",
    "start": "pnpm --filter @nudge/server... build && pnpm --filter @nudge/server start",
    "console:start": "pnpm --filter @nudge/console... build && pnpm --filter @nudge/console start",
    "console:auth": "pnpm --filter @nudge/console auth",
    "release:pack": "pnpm build && bash scripts/release/package.sh",
    "release:smoke": "bash scripts/release/smoke.sh",
    "build": "pnpm -r --filter=!@nudge/web build",
    "site:dev": "pnpm --filter @nudge/web dev",
    "site:build": "pnpm --filter @nudge/web build",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm test"
  },
  "pnpm": {
    "overrides": {
      "@opentelemetry/core@<2.8.0": "2.10.0"
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
