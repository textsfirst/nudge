# Secrets only — all other settings live in the database and are edited on
# the console's Settings page.

# Photon / Spectrum Cloud credentials from https://app.photon.codes
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Optional API provider key (see the Provider section in console Settings).
OPENAI_API_KEY=

# Optional: key for a custom OpenAI-compatible endpoint (see the Provider
# section in console Settings). Omit for keyless local servers.
CUSTOM_API_KEY=

# Optional: enables the web_search and web_extract tools (https://firecrawl.dev).
FIRECRAWL_API_KEY=

# Optional: speech-to-text key for the owner's voice memos (see the Multimodal
# section in console Settings). Falls back to OPENAI_API_KEY when unset.
TRANSCRIPTION_API_KEY=

# MCP server credentials also live here: any ${VAR} referenced from
# DATA_DIR/mcp/servers.json is resolved from this file. Add keys freely
# (e.g. GITHUB_MCP_TOKEN=...) via the console's Secrets page.

# Bootstrap values (not secrets) — needed before the settings database can be
# opened, so they live here rather than in it. Defaults shown.
# NUDGE_DATA_DIR=.data
# PORT=3000
# LOG_LEVEL=info

# Console bootstrap. Local mode accepts only loopback hosts and exact origins.
# CONSOLE_HOST=127.0.0.1
# CONSOLE_PORT=3100
# CONSOLE_UI_ORIGIN=http://localhost:5174
# NUDGE_CONSOLE_URL=http://localhost:5174

# Remote mode is opt-in and requires TLS at this exact public origin.
# CONSOLE_REMOTE=1
# CONSOLE_PUBLIC_ORIGIN=https://console.example.com
