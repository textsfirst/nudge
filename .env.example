# The one handle allowed to talk to Nudge. Use the exact sender.id Photon sends.
OWNER_IMESSAGE_HANDLE=+15551234567

# Photon / Spectrum Cloud credentials from https://app.photon.codes
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
SPECTRUM_WEBHOOK_SECRET=

# chatgpt-subscription (default) or openai-api
MODEL_PROVIDER=chatgpt-subscription
CHATGPT_MODEL=gpt-5.4-mini
CHATGPT_AUTH_FILE=.data/chatgpt-auth.json

# Optional API provider, and automatic fallback for subscription auth failures.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_FALLBACK_ENABLED=true

# Reasoning level for model calls: none, minimal, low, medium, high, xhigh, max.
# Unset uses the model's default.
REASONING_EFFORT=

# true routes model calls through the priority service tier (faster output).
FAST_MODE=false

# Optional: enables the web_search and web_extract tools (https://firecrawl.dev).
# The tools are hidden from the model when both are unset. FIRECRAWL_API_URL is
# for self-hosted instances (no key needed).
FIRECRAWL_API_KEY=
#FIRECRAWL_API_URL=http://localhost:3002

# The bash tool runs shell commands with DATA_DIR as the working directory
# (a default, not a sandbox). Set to false to remove the tool entirely.
BASH_TOOL_ENABLED=true

# Where Nudge keeps its SQLite database, SYSTEM.md, SCHEDULE.md, and skills/.
DATA_DIR=.data

# IANA timezone for schedules and midnight thread rollover. Defaults to the
# machine's timezone when unset.
#OWNER_TIMEZONE=America/Los_Angeles

# Threads roll over silently after this many idle hours (and at local midnight).
IDLE_THREAD_HOURS=6

# How long to wait for follow-up texts before replying to a burst as one message.
DEBOUNCE_MS=2500

# Agent loop limits.
MAX_TOOL_STEPS=8
MAX_HISTORY_MESSAGES=40

PORT=3000
LOG_LEVEL=info
